# Development placeholders only. Copy to .env for local overrides.
APP_NAME=Second Brain API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://second_brain:change-me@db:5432/second_brain

OPENAI_API_KEY=
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-5.6-terra
EXTRACTION_PROMPT_VERSION=memory_proposals_v1
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_MAX_OUTPUT_TOKENS=8000
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
